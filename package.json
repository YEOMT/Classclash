{
  "name": "class-clash",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts --dev",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/build.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:load": "tsx scripts/load-test.ts",
    "test:soak": "tsx scripts/soak-test.ts",
    "assets": "node scripts/pack-art.mjs && node scripts/validate-art.mjs",
    "test:render-perf": "playwright test --config tests/e2e/performance.config.ts",
    "test:jungle": "playwright test --config tests/e2e/jungle.config.ts",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:art-preservation": "node scripts/test-art-preservation.mjs",
    "test:v02": "playwright test --config tests/e2e/v02.config.ts",
    "test:realtime": "node scripts/verify-v02-realtime.mjs",
    "assets:public-check": "node scripts/check-public-assets.mjs",
    "test:source": "node scripts/test-source.mjs",
    "test:soak:parallel": "node scripts/soak-parallel.mjs"
  },
  "dependencies": {
    "pixi.js": "8.22.0",
    "qrcode": "1.5.4",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
