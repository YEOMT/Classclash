{
  "name": "class-clash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts --dev",
    "build": "node scripts/build-sprites.mjs && vite build && esbuild src/server/index.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/server.js",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:load": "tsx scripts/load-test.ts",
    "test:soak": "tsx scripts/soak-test.ts",
    "assets": "node scripts/build-sprites.mjs",
    "test:render-perf": "playwright test --config tests/e2e/performance.config.ts"
  },
  "dependencies": {
    "pixi.js": "8.22.0",
    "qrcode": "1.5.4",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
